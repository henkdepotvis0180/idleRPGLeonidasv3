{
  "expo": {
    "name": "Leonidas V3",
    "slug": "idle-rpg-leonidas-v3",
    "version": "0.4.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "web"
    ],
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.leonidas.idlerpgv3",
      "versionCode": 3
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
